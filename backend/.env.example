PORT=4000
# Coloca aquí tu URI de MongoDB local o MongoDB Atlas.
# Si MongoDB no está disponible localmente, el servidor activará automáticamente el motor de persistencia local con los datos semilla.
MONGO_URI=mongodb://127.0.0.1:27017/MyTinerary
SECRET_KEY=MyTineraryLocalSecretKey2026
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REQUIRE_EMAIL_VERIFICATION=false
# Opcional: Configuración SMTP para envío de correos de verificación
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tu_correo@gmail.com
# SMTP_PASS=tu_app_password
