# ==============================================================================
# MyTinerary - Unified Environment Variables for Vercel & Local Development
# ==============================================================================

# MongoDB Connection String (MongoDB Atlas Cluster)
# Vercel MongoDB integration standard variable name is MONGODB_URI (MONGO_URI is also supported)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ejehvtx.mongodb.net/MyTinerary?retryWrites=true&w=majority&appName=Cluster0
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.ejehvtx.mongodb.net/MyTinerary?retryWrites=true&w=majority&appName=Cluster0

# Authentication & JWT Secret Key
SECRET_KEY=MyTineraryLocalSecretKey2026

# Local Standalone Server Settings (Only required for local node backend/server.js)
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REQUIRE_EMAIL_VERIFICATION=false

# Frontend API URL
# Leave empty on Vercel to make automatic same-origin /api requests
# Set to http://localhost:4000/api if running frontend and backend independently without proxy
REACT_APP_API_URL=
